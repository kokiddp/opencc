#!/usr/bin/env bash
set -euo pipefail

# opencc — runs Claude Code against alternative backends:
#
#   go        the opencode-go gateway from OpenCode (https://opencode.ai/zen/go).
#             Authenticates via the x-api-key header; a local pass-through
#             proxy normalizes the effort for the selected model.
#   openai    OpenAI models via a ChatGPT subscription (Codex CLI OAuth token)
#             or an API key, through the local proxy `opencc-proxy.mjs`, which
#             translates the Anthropic protocol into Responses.
#   anthropic stock Claude Code behavior: pure pass-through, without touching
#             endpoint, authentication, model, effort or settings.
#
# Commands:
#   opencc login                  ChatGPT login (Codex CLI device flow)
#   opencc [args for claude]      backend + models + reasoning menu, then launch
#
# Variables:
#   OPENCC_BACKEND    go | openai | anthropic  (skips the backend menu)
#   OPENCC_MODE       subscription | apikey  (openai backend only)
#   OPENCC_PROXY_PORT local proxy port (default 3199, openai and go)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Go backend configuration -------------------------------------------------
GO_BASE_URL="https://opencode.ai/zen/go"
GO_MODELS_URL="https://opencode.ai/zen/go/v1/models"
GO_CATALOG_URL="https://models.opencode.ai/api.json"
GO_FALLBACK_MODEL="minimax-m3"
GO_MODELS_MAX_AGE=$((7 * 24 * 3600))
GO_AUTH_JSON="$HOME/.local/share/opencode/auth.json"

# --- OpenAI backend configuration ---------------------------------------------
PROXY_SCRIPT="$SCRIPT_DIR/opencc-proxy.mjs"
EXPECTED_PROXY_VERSION="5"
PORT="${OPENCC_PROXY_PORT:-3199}"
PROXY_BASE_URL="http://127.0.0.1:$PORT"
CODEX_AUTH="$HOME/.codex/auth.json"
CODEX_MODELS_CACHE="$HOME/.codex/models_cache.json"

# Fallback model list if the OpenAI models cannot be fetched.
OPENAI_FALLBACK_MODELS="gpt-5.6-sol
gpt-5.6-terra
gpt-5.6-luna
gpt-5.5
gpt-5.4
gpt-5.4-mini"

# --- State --------------------------------------------------------------------
STATE_ROOT="$HOME/.local/state/opencc"
BACKEND_FILE="$STATE_ROOT/last-backend"

require_base_tools() {
  local cmd
  for cmd in curl python3; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "Error: '$cmd' not found on PATH." >&2; exit 1; }
  done
}

fmt_ctx() {
  local c="$1"
  (( c >= 1000000 )) && { printf '%dM' "$((c / 1000000))"; return; }
  (( c >= 1000 )) && { printf '%dK' "$((c / 1000))"; return; }
  printf '%d' "$c"
}

has_codex_auth() {
  [[ -f "$CODEX_AUTH" ]] || return 1
  python3 - "$CODEX_AUTH" <<'PY' 2>/dev/null
import json, sys
try:
    a = json.load(open(sys.argv[1]))
    sys.exit(0 if a.get("tokens", {}).get("access_token") else 1)
except Exception:
    sys.exit(1)
PY
}

codex_login() {
  if ! command -v codex >/dev/null 2>&1; then
    echo "Error: the Codex CLI is not installed." >&2
    echo "        Install it (https://github.com/openai/codex) or use apikey mode (OPENAI_API_KEY)." >&2
    return 1
  fi
  echo "Starting ChatGPT login (device flow: open the link and enter the code)..."
  codex login --device-auth
}

# --- 0) `login` command -------------------------------------------------------
if [[ "${1:-}" == "login" ]]; then
  require_base_tools
  codex_login || exit 1
  if has_codex_auth; then
    echo "Login completed: $CODEX_AUTH updated."
    exit 0
  fi
  echo "Error: login failed ($CODEX_AUTH has no token)." >&2
  exit 1
fi

# --- 1) Migration of state from the old scripts -------------------------------
mkdir -p "$STATE_ROOT/go" "$STATE_ROOT/openai"
# opencc <= 1 kept the OpenAI state directly in $STATE_ROOT.
for f in last-model last-effort; do
  [[ -f "$STATE_ROOT/$f" && ! -f "$STATE_ROOT/openai/$f" ]] && mv -f "$STATE_ROOT/$f" "$STATE_ROOT/openai/$f"
done

# --- 2) Backend selection -----------------------------------------------------
BACKEND="${OPENCC_BACKEND:-}"
if [[ -z "$BACKEND" ]]; then
  BACKEND_DEFAULT="openai"
  if [[ -f "$BACKEND_FILE" ]]; then
    STORED_BACKEND="$(<"$BACKEND_FILE")"
    [[ "$STORED_BACKEND" == "go" || "$STORED_BACKEND" == "openai" || "$STORED_BACKEND" == "anthropic" ]] && BACKEND_DEFAULT="$STORED_BACKEND"
  fi
  echo "Available backends:"
  echo "   1) openai  — OpenAI models (ChatGPT subscription or API key, local proxy)"
  echo "   2) go      — OpenCode Go gateway (x-api-key)"
  echo "   0) anthropic — stock Claude Code (pass-through, no changes)"
  while true; do
    printf "\nChoose backend [0-2] (enter/d = %s): " "$BACKEND_DEFAULT"
    read -r CHOICE || CHOICE=""
    case "$CHOICE" in
      ""|d) BACKEND="$BACKEND_DEFAULT"; break ;;
      0|anthropic) BACKEND="anthropic"; break ;;
      1|openai) BACKEND="openai"; break ;;
      2|go) BACKEND="go"; break ;;
      *) echo "Invalid choice, try again." ;;
    esac
  done
fi
case "$BACKEND" in
  go|openai|anthropic) ;;
  *) echo "Error: invalid backend ('$BACKEND'); use go, openai or anthropic." >&2; exit 1 ;;
esac
printf '%s\n' "$BACKEND" > "$BACKEND_FILE"

if [[ "$BACKEND" == "anthropic" ]]; then
  echo "Starting stock Claude Code (backend: anthropic)."
  exec claude "$@"
fi

require_base_tools
command -v node >/dev/null 2>&1 || { echo "Error: 'node' not found on PATH (required by the proxy)." >&2; exit 1; }

STATE_DIR="$STATE_ROOT/$BACKEND"
STATE_FILE="$STATE_DIR/last-model"
STATE_EFFORT_FILE="$STATE_DIR/last-effort"
MODELS_CACHE="$STATE_DIR/models.tsv"

# --- 3) Credentials and model list --------------------------------------------
# Shared TSV format: slug<TAB>name<TAB>context<TAB>reasoning levels<TAB>default
MODELS=""
MODE=""
KEY=""

if [[ "$BACKEND" == "go" ]]; then
  # API key: OPENCODE_API_KEY env var, falling back to auth.json (parsed with python3, no jq)
  if [[ -n "${OPENCODE_API_KEY:-}" ]]; then
    KEY="$OPENCODE_API_KEY"
  elif [[ -f "$GO_AUTH_JSON" ]]; then
    KEY="$(python3 - "$GO_AUTH_JSON" <<'PY' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('opencode-go', {}).get('key', ''))
except Exception:
    pass
PY
)"
  fi
  if [[ -z "$KEY" ]]; then
    echo "Error: no API key found (set OPENCODE_API_KEY or log in with opencode)." >&2
    exit 1
  fi

  # Model cache: list from /v1/models, context and effort from the upstream
  # catalog. Built once and refreshed in the background when stale.
  build_go_models_tsv() {
    local ids tmp
    ids="$(curl -fsS -m 15 -H "x-api-key: $KEY" "$GO_MODELS_URL" 2>/dev/null | python3 -c '
import sys, json
try:
    print("\n".join(m.get("id", "") for m in json.load(sys.stdin).get("data", [])))
except Exception:
    pass
' || true)"
    [[ -z "$ids" ]] && return 1
    tmp="$(mktemp "$MODELS_CACHE.XXXXXX")" || return 1
    if curl -fsS -m 25 "$GO_CATALOG_URL" 2>/dev/null | python3 -c '
import json, sys
# Claude Code accepts these levels in --effort: intersect them with the model.
CLAUDE_EFFORTS = {"low","medium","high","xhigh","max"}
try:
    cat = json.load(sys.stdin)
    go = cat.get("opencode-go", {}).get("models", {})
except Exception:
    go = {}
for mid in sys.argv[1].splitlines():
    m = go.get(mid, {}) or {}
    ctx = (m.get("limit") or {}).get("context") or ""
    efforts = ""
    for o in m.get("reasoning_options") or []:
        if o.get("type") == "effort":
            efforts = ",".join(v for v in o.get("values", []) if v in CLAUDE_EFFORTS)
            break
    print(f"{mid}\t{mid}\t{ctx}\t{efforts}\t")
' "$ids" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
      mv -f "$tmp" "$MODELS_CACHE"
      printf '%s\n' "$ids" > "$STATE_DIR/models.ids"
      return 0
    fi
    rm -f "$tmp"
    return 1
  }

  [[ -s "$MODELS_CACHE" ]] || build_go_models_tsv >/dev/null 2>&1 || true

  # NB: $(<file) must not be combined with a redirect or `|| true` (yields empty output).
  if [[ -s "$MODELS_CACHE" ]]; then
    MODELS="$(<"$MODELS_CACHE")"
    # Stale cache: refresh without blocking startup.
    cache_age=$(( $(date +%s) - $(stat -c %Y "$MODELS_CACHE" 2>/dev/null || echo 0) ))
    (( cache_age > GO_MODELS_MAX_AGE )) && { build_go_models_tsv >/dev/null 2>&1 & disown; }
  fi
  if [[ -z "$MODELS" ]]; then
    MODELS="$(printf '%s\t%s\t\t\t' "$GO_FALLBACK_MODEL" "$GO_FALLBACK_MODEL")"
  fi

else
  # Authentication mode: subscription (default) or apikey.
  MODE="${OPENCC_MODE:-}"
  if [[ -z "$MODE" ]]; then
    if has_codex_auth; then
      MODE="subscription"
    elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
      MODE="apikey"
    else
      # No credentials: offer the subscription login (prompt below).
      MODE="subscription"
    fi
  fi
  case "$MODE" in
    subscription|apikey) ;;
    *) echo "Error: invalid OPENCC_MODE ('$MODE'); use subscription or apikey." >&2; exit 1 ;;
  esac
  if [[ "$MODE" == "apikey" && -z "${OPENAI_API_KEY:-}" ]]; then
    echo "Error: apikey mode requires OPENAI_API_KEY." >&2
    exit 1
  fi

  # Missing subscription auth: offer the login.
  if [[ "$MODE" == "subscription" ]] && ! has_codex_auth; then
    echo "ChatGPT authentication not found ($CODEX_AUTH missing or without a token)." >&2
    printf "Log in now (device flow via Codex)? [y/N] "
    read -r ANS || ANS=""
    if [[ "$ANS" =~ ^[yY]$ ]]; then
      codex_login || exit 1
    fi
    if ! has_codex_auth; then
      echo "Error: no login completed. Retry with \`opencc login\` or set OPENAI_API_KEY." >&2
      exit 1
    fi
  fi

  # The context is max_context_window × effective_context_window_percent (95%),
  # i.e. the extended window the backend supports for the plan.
  if [[ "$MODE" == "subscription" ]] && [[ -f "$CODEX_MODELS_CACHE" ]]; then
    MODELS="$(python3 - "$CODEX_MODELS_CACHE" <<'PY' 2>/dev/null || true
import json, sys
d = json.load(open(sys.argv[1]))
for m in d.get("models", []):
    slug = m.get("slug", "")
    if not slug or slug == "codex-auto-review":
        continue
    disp = m.get("display_name") or slug
    ctx = ""
    mw = m.get("max_context_window") or m.get("context_window")
    eff = m.get("effective_context_window_percent")
    try:
        if mw and eff:
            ctx = int(int(mw) * int(eff) / 100)
    except Exception:
        ctx = ""
    efforts = ",".join(e.get("effort", "") for e in m.get("supported_reasoning_levels", []) if e.get("effort"))
    dflt = m.get("default_reasoning_level") or ""
    print(f"{slug}\t{disp}\t{ctx}\t{efforts}\t{dflt}")
PY
)"
  fi
  if [[ -z "$MODELS" ]] && [[ "$MODE" == "apikey" ]] && [[ -n "${OPENAI_API_KEY:-}" ]]; then
    MODELS="$(curl -fsS -m 20 -H "Authorization: Bearer $OPENAI_API_KEY" \
      "https://api.openai.com/v1/models" 2>/dev/null | python3 -c '
import json, sys, re
d = json.load(sys.stdin)
for m in d.get("data", []):
    mid = m.get("id", "")
    if re.search(r"^gpt-|^o[0-9]", mid) and not re.search(r"realtime|audio|image|whisper|tts|embed|dall|moderation|vision|codex", mid):
        print(f"{mid}\t{mid}\t\tlow,medium,high\tmedium")
' 2>/dev/null || true)"
  fi
  if [[ -z "$MODELS" ]]; then
    MODELS="$(while IFS= read -r slug; do
      case "$slug" in
        gpt-5.6-sol|gpt-5.6-terra|gpt-5.6-luna) e="low,medium,high,xhigh,max,ultra"; d="low" ;;
        gpt-5.5|gpt-5.4|gpt-5.4-mini) e="low,medium,high,xhigh"; d="medium" ;;
        *) e="low,medium,high"; d="medium" ;;
      esac
      printf '%s\t%s\t\t%s\t%s\n' "$slug" "$slug" "$e" "$d"
    done <<< "$OPENAI_FALLBACK_MODELS")"
  fi
fi

MODEL_ARR=()
DISPLAY_ARR=()
declare -A CTX=()
declare -A EFFORTS=()
declare -A DFLT_EFFORT=()
# NB: the tab is an IFS "whitespace" separator, so `read -r a b c` would collapse
# consecutive tabs and shift the fields when a column is empty (unknown context):
# the lines must be split by hand.
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  slug="${line%%$'\t'*}";    line="${line#*$'\t'}"
  disp="${line%%$'\t'*}";    line="${line#*$'\t'}"
  ctx="${line%%$'\t'*}";     line="${line#*$'\t'}"
  efforts="${line%%$'\t'*}"; dflt="${line#*$'\t'}"
  [[ -z "$slug" ]] && continue
  MODEL_ARR+=("$slug")
  DISPLAY_ARR+=("${disp:-$slug}")
  [[ -n "$ctx" ]] && CTX["$slug"]="$ctx"
  [[ -n "$efforts" ]] && EFFORTS["$slug"]="$efforts"
  [[ -n "$dflt" ]] && DFLT_EFFORT["$slug"]="$dflt"
done <<< "$MODELS"

if [[ ${#MODEL_ARR[@]} -eq 0 ]]; then
  echo "Error: no models available." >&2
  exit 1
fi

# Claude Code filters out of automatic discovery every ID that does not
# contain `claude` or `anthropic`; our real IDs (`gpt-*`, `minimax-*`, etc.)
# would therefore never show up in /model even with a valid /v1/models
# endpoint. modelPicker is the native mechanism that accepts arbitrary IDs: we
# generate options specific to the current backend and hide the Anthropic
# aliases, which would be misleading with these gateways.
PICKER_SETTINGS_FILE="$STATE_DIR/model-picker.json"
EFFORT_POLICY_FILE="$STATE_DIR/model-efforts.json"
if [[ "$BACKEND" == "go" ]]; then
  PICKER_DESCRIPTION="OpenCode Go via opencc"
else
  PICKER_DESCRIPTION="OpenAI via opencc ($MODE)"
fi
printf '%s\n' "$MODELS" | python3 -c '
import json, os, sys, tempfile
picker_output, policy_output, base_description = sys.argv[1:4]
options = []
policies = {}
for line in sys.stdin:
    fields = (line.rstrip("\n").split("\t") + [""] * 5)[:5]
    model, label, _context, effort_csv, default = fields
    if not model:
        continue
    label = label or model
    supported = [v for v in effort_csv.split(",") if v]
    if default not in supported:
        default = ""
    if supported:
        effort_description = "effort: " + ", ".join(supported)
        if default:
            effort_description += f" (default: {default})"
    else:
        effort_description = "effort: non configurabile"
    options.append({
        "model": model,
        "label": label,
        "description": f"{base_description} · {effort_description}",
    })
    policies[model] = {"supported": supported, "default": default or None}

def atomic_json(path, data, prefix):
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=prefix, dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass

atomic_json(picker_output, {
    "modelPicker": {"replaceBuiltInOptions": True, "options": options}
}, ".model-picker.")
atomic_json(policy_output, {"models": policies}, ".model-efforts.")
' "$PICKER_SETTINGS_FILE" "$EFFORT_POLICY_FILE" "$PICKER_DESCRIPTION"

# --- 4) Default = last used (if still available) ------------------------------
if [[ "$BACKEND" == "go" ]]; then
  DEFAULT="$GO_FALLBACK_MODEL"
  [[ " ${MODEL_ARR[*]} " == *" $DEFAULT "* ]] || DEFAULT="${MODEL_ARR[0]}"
else
  DEFAULT="${MODEL_ARR[0]}"
fi
LAST_USED=""
if [[ -f "$STATE_FILE" ]]; then
  STORED="$(<"$STATE_FILE")"
  for m in "${MODEL_ARR[@]}"; do
    [[ "$m" == "$STORED" ]] && { DEFAULT="$STORED"; LAST_USED="$STORED"; break; }
  done
fi

# --- 5) Numbered menu ---------------------------------------------------------
if [[ "$BACKEND" == "go" ]]; then
  echo "OpenCode Go models:"
else
  echo "OpenAI models (auth: $MODE):"
fi
for i in "${!MODEL_ARR[@]}"; do
  tag=""
  ctxstr=""
  [[ -n "${CTX[${MODEL_ARR[$i]}]:-}" ]] && ctxstr="  [$(fmt_ctx "${CTX[${MODEL_ARR[$i]}]}")]"
  [[ "${MODEL_ARR[$i]}" == "$LAST_USED" ]] && tag="  (last used)"
  printf "  %2d) %s%s%s\n" "$((i+1))" "${DISPLAY_ARR[$i]}" "$ctxstr" "$tag"
done

while true; do
  printf "\nChoose a model [1-%d] (enter/%s = %s): " "${#MODEL_ARR[@]}" "d" "$DEFAULT"
  read -r CHOICE || CHOICE=""
  [[ -z "$CHOICE" || "$CHOICE" == "d" ]] && { MODEL="$DEFAULT"; break; }
  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= ${#MODEL_ARR[@]} )); then
    MODEL="${MODEL_ARR[$((CHOICE-1))]}"
    break
  fi
  echo "Invalid choice, try again."
done

# --- 6) Reasoning level (effort) ----------------------------------------------
# On the go backend, `toggle` models (always-on reasoning) expose no levels:
# in that case the prompt is skipped.
if [[ "$BACKEND" == "go" ]]; then
  VALID_EFFORTS="${EFFORTS[$MODEL]:-}"
else
  VALID_EFFORTS="${EFFORTS[$MODEL]:-low,medium,high}"
fi
EFFORT=""
if [[ -n "$VALID_EFFORTS" ]]; then
  EFFORT_DEFAULT=""
  if [[ -f "$STATE_EFFORT_FILE" ]]; then
    EFFORT_DEFAULT="$(<"$STATE_EFFORT_FILE")"
    # If the saved default is not valid for this model, start from empty.
    [[ ",$VALID_EFFORTS," == *",$EFFORT_DEFAULT,"* ]] || EFFORT_DEFAULT=""
  fi
  DFLT_SHOW="${DFLT_EFFORT[$MODEL]:-}"
  DEFPROMPT="${EFFORT_DEFAULT:-model default${DFLT_SHOW:+ ($DFLT_SHOW)}}"
  printf "Reasoning level [%s] (enter = %s): " "$VALID_EFFORTS" "$DEFPROMPT"
  read -r EFFORT || EFFORT=""
  [[ -z "$EFFORT" ]] && EFFORT="$EFFORT_DEFAULT"
  if [[ -n "$EFFORT" ]] && ! [[ ",$VALID_EFFORTS," == *",$EFFORT,"* ]]; then
    echo "Invalid level ('$EFFORT'); using the default." >&2
    EFFORT="$EFFORT_DEFAULT"
  fi
fi

# Claude Code sends efforts low..max in output_config.effort. `ultra` is not
# available in /effort, so it stays encoded in the model as @ultra.
if [[ "$EFFORT" == "ultra" ]]; then
  MODEL_EFFORT="${MODEL}@ultra"
else
  MODEL_EFFORT="$MODEL"
fi

# --- 7) Save the last model + effort ------------------------------------------
printf '%s\n' "$MODEL" > "$STATE_FILE"
printf '%s\n' "$EFFORT" > "$STATE_EFFORT_FILE"

# --- 8) Local proxy: start it, or reuse it if already consistent ---------------
if [[ "$BACKEND" == "go" ]]; then
  PROXY_MODE="go"
else
  PROXY_MODE="$MODE"
fi

ensure_proxy() {
  local health ver mode
  health="$(curl -fsS -m 2 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
  if [[ -n "$health" ]]; then
    ver="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)"
    mode="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("mode", ""))' 2>/dev/null || true)"
    if [[ "$ver" == "$EXPECTED_PROXY_VERSION" && "$mode" == "$PROXY_MODE" ]]; then
      return 0
    fi
    echo "Error: an incompatible opencc proxy is already listening on port $PORT" >&2
    echo "        (different version or mode)." >&2
    echo "        Close it manually or use a different port with OPENCC_PROXY_PORT." >&2
    exit 1
  else
    # Port in use by a foreign process?
    if (command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]${PORT} ") || \
       (command -v lsof >/dev/null 2>&1 && lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1); then
      echo "Error: port $PORT is in use by another process." >&2
      echo "        Set OPENCC_PROXY_PORT to a free port." >&2
      exit 1
    fi
  fi

  [[ -f "$PROXY_SCRIPT" ]] || { echo "Error: $PROXY_SCRIPT not found (missing next to opencc)." >&2; exit 1; }

  local models_csv
  models_csv="$(IFS=,; printf '%s' "${MODEL_ARR[*]}")"
  OPENCC_MODE="$PROXY_MODE" \
  OPENAI_API_KEY="${OPENAI_API_KEY:-}" \
  OPENCODE_API_KEY="$KEY" \
  OPENCC_GO_BASE_URL="$GO_BASE_URL" \
  OPENCC_PROXY_PORT="$PORT" \
  OPENCC_FALLBACK_MODEL="$MODEL_EFFORT" \
  OPENCC_MODELS="$models_csv" \
  OPENCC_EFFORT_POLICY_FILE="$EFFORT_POLICY_FILE" \
  nohup node "$PROXY_SCRIPT" >>"$STATE_DIR/proxy.log" 2>&1 &
  local proxy_pid=$!
  printf '%s\n' "$proxy_pid" > "$STATE_DIR/proxy.pid"
  disown "$proxy_pid"

  for _ in $(seq 1 25); do
    health="$(curl -fsS -m 1 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
    [[ -n "$health" ]] && return 0
    sleep 0.1
  done
  echo "Error: the proxy failed to start (log: $STATE_DIR/proxy.log)." >&2
  exit 1
}

# --- 8b) Session registry: the proxy closes with the last session --------------
# Every invocation registers a file in $STATE_DIR/sessions/<pid>.sess with the
# port|mode pair of the proxy it uses. On exit from claude the file is removed;
# if no session remains on the same proxy, the proxy is stopped. Files left
# behind by abnormally terminated sessions (dead PID) are swept at the next
# startup.
SESSION_DIR="$STATE_DIR/sessions"
mkdir -p "$SESSION_DIR"

sweep_stale_sessions() {
  local f pid
  for f in "$SESSION_DIR"/*.sess; do
    [[ -e "$f" ]] || continue
    pid="${f##*/}"; pid="${pid%.sess}"
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
}

sessions_on_proxy() {
  local f
  local n=0
  for f in "$SESSION_DIR"/*.sess; do
    [[ -e "$f" ]] || continue
    [[ "$(<"$f")" == "$PORT|$PROXY_MODE" ]] && (( n++ ))
  done
  printf '%d' "$n"
}

stop_proxy_if_last() {
  rm -f "$SESSION_DIR/$$.sess"
  sweep_stale_sessions
  if [[ "$(sessions_on_proxy)" == "0" ]]; then
    local health ver mode
    health="$(curl -fsS -m 2 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
    if [[ -n "$health" ]]; then
      ver="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)"
      mode="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("mode", ""))' 2>/dev/null || true)"
      if [[ "$ver" == "$EXPECTED_PROXY_VERSION" && "$mode" == "$PROXY_MODE" ]]; then
        kill "$(<"$STATE_DIR/proxy.pid")" 2>/dev/null || true
        rm -f "$STATE_DIR/proxy.pid"
        echo "opencc proxy stopped (last session closed)." >&2
      fi
    fi
  fi
}

# Early registration (before ensure_proxy): if another session exits while this
# one is still starting up, the proxy is not yanked away from under it.
sweep_stale_sessions
printf '%s\n' "$PORT|$PROXY_MODE" > "$SESSION_DIR/$$.sess"
trap stop_proxy_if_last EXIT

# --- 9) Exports and launch ----------------------------------------------------
unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_IDENTITY_TOKEN
EXTRA=()

ensure_proxy
export ANTHROPIC_BASE_URL="$PROXY_BASE_URL"
if [[ "$BACKEND" == "openai" && "$MODE" == "apikey" ]]; then
  export ANTHROPIC_API_KEY="$OPENAI_API_KEY"
else
  # The proxy handles upstream auth; any non-empty local value is enough to
  # disable Claude Code's OAuth login.
  export ANTHROPIC_API_KEY="opencc-$PROXY_MODE"
fi
unset ANTHROPIC_CUSTOM_HEADERS
export ANTHROPIC_DEFAULT_MODEL="$MODEL_EFFORT"
export ANTHROPIC_MODEL="$MODEL_EFFORT"

# The model is proposed as the session default; the options generated in
# model-picker.json then let `/model` change it at runtime.
unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY

# The effort must be passed with --effort, which sets the level *of the
# session*: it stays changeable with /effort. The CLAUDE_CODE_EFFORT_LEVEL
# variable would instead pin it for the whole process, making /effort
# ineffective: it must even be unset if inherited from the environment. `ultra`
# is not accepted by --effort (it would be silently ignored): it stays encoded
# in the model as @ultra.
unset CLAUDE_CODE_EFFORT_LEVEL
if [[ -n "$EFFORT" && "$EFFORT" != "ultra" ]] && [[ "$*" != *"--effort"* ]]; then
  EXTRA=(--effort "$EFFORT")
fi

export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL_EFFORT"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL_EFFORT"
# The haiku alias feeds the auto-mode classifier and the background tasks.
# The classifier uses max_tokens=1: reasoning models spend that token on
# thinking and produce no text, so auto mode fails. We pin the alias to a
# small model WITHOUT reasoning.
if [[ "$BACKEND" == "go" ]]; then
  CLASSIFIER_MODEL="minimax-m3"
  for m in "${MODEL_ARR[@]}"; do
    [[ -z "${EFFORTS[$m]:-}" ]] && { CLASSIFIER_MODEL="$m"; break; }
  done
else
  CLASSIFIER_MODEL="gpt-5.4-mini"
  for m in "${MODEL_ARR[@]}"; do
    [[ "$m" == *mini* ]] && { CLASSIFIER_MODEL="$m"; break; }
  done
  [[ " ${MODEL_ARR[*]} " == *" $CLASSIFIER_MODEL "* ]] || CLASSIFIER_MODEL="${MODEL_ARR[0]}"
fi
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLASSIFIER_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL_EFFORT"
if [[ -n "${CTX[$MODEL]:-}" ]]; then
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CTX[$MODEL]}"
fi

CTXSTR=""
[[ -n "${CTX[$MODEL]:-}" ]] && CTXSTR=", contesto: $(fmt_ctx "${CTX[$MODEL]}")"
EFFSTR=""
[[ -n "$EFFORT" ]] && EFFSTR=", reasoning: $EFFORT"
if [[ "$BACKEND" == "go" ]]; then
  echo "Starting Claude Code with model: $MODEL (backend: go$CTXSTR$EFFSTR)"
else
  echo "Starting Claude Code with model: $MODEL (backend: openai/$MODE$CTXSTR$EFFSTR)"
fi
echo "During the session: /model changes the model, /effort changes the reasoning."

# The registration happened in section 8 (before ensure_proxy), so a session
# that exits while another one is starting up does not close the proxy.
# set +e: claude may exit with a non-zero code; we propagate it ourselves.
set +e
claude --settings "$PICKER_SETTINGS_FILE" "${EXTRA[@]}" "$@"
status=$?
set -e
exit $status
