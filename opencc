#!/usr/bin/env bash
set -euo pipefail

# opencc — avvia Claude Code su backend alternativi.
#
# Unifica i due wrapper precedenti (`cc-go` e `opencc`) in un unico tool con tre
# backend selezionabili:
#
#   go      gateway opencode-go di OpenCode (https://opencode.ai/zen/go).
#           Autenticazione via header x-api-key; un proxy locale pass-through
#           normalizza l'effort in base al modello selezionato.
#   openai  modelli OpenAI tramite abbonamento ChatGPT (token OAuth del CLI
#           Codex) o API key, attraverso il proxy locale `opencc-proxy.mjs` che
#           traduce il protocollo Anthropic in Responses.
#   anthropic comportamento standard di Claude Code: pass-through puro, senza
#             modificare endpoint, autenticazione, modello, effort o settings.
#
# Comandi:
#   opencc login                  login ChatGPT (device flow del CLI Codex)
#   opencc [argomenti per claude] menu backend + modelli + ragionamento, poi avvia
#
# Variabili:
#   OPENCC_BACKEND    go | openai | anthropic  (salta il menu backend)
#   OPENCC_MODE       subscription | apikey  (solo backend openai)
#   OPENCC_PROXY_PORT porta del proxy locale (default 3199, openai e go)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Configurazione backend go ------------------------------------------------
GO_BASE_URL="https://opencode.ai/zen/go"
GO_MODELS_URL="https://opencode.ai/zen/go/v1/models"
GO_CATALOG_URL="https://models.opencode.ai/api.json"
GO_FALLBACK_MODEL="minimax-m3"
GO_MODELS_MAX_AGE=$((7 * 24 * 3600))
GO_AUTH_JSON="$HOME/.local/share/opencode/auth.json"

# --- Configurazione backend openai --------------------------------------------
PROXY_SCRIPT="$SCRIPT_DIR/opencc-proxy.mjs"
EXPECTED_PROXY_VERSION="5"
PORT="${OPENCC_PROXY_PORT:-3199}"
PROXY_BASE_URL="http://127.0.0.1:$PORT"
CODEX_AUTH="$HOME/.codex/auth.json"
CODEX_MODELS_CACHE="$HOME/.codex/models_cache.json"

# Elenco di ripiego se non si riesce a recuperare i modelli OpenAI.
OPENAI_FALLBACK_MODELS="gpt-5.6-sol
gpt-5.6-terra
gpt-5.6-luna
gpt-5.5
gpt-5.4
gpt-5.4-mini"

# --- Stato --------------------------------------------------------------------
STATE_ROOT="$HOME/.local/state/opencc"
BACKEND_FILE="$STATE_ROOT/last-backend"

require_base_tools() {
  local cmd
  for cmd in curl python3; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "Errore: '$cmd' non trovato nel PATH." >&2; exit 1; }
  done
}

fmt_ctx() {
  local c="$1"
  (( c >= 1000000 )) && { printf '%dM' "$((c / 1000000))"; return; }
  (( c >= 1000 )) && { printf '%dK' "$((c / 1000))"; return; }
  printf '%d' "$c"
}

has_codex_auth() {
  [[ -f "$CODEX_AUTH" ]] || return 1
  python3 - "$CODEX_AUTH" <<'PY' 2>/dev/null
import json, sys
try:
    a = json.load(open(sys.argv[1]))
    sys.exit(0 if a.get("tokens", {}).get("access_token") else 1)
except Exception:
    sys.exit(1)
PY
}

codex_login() {
  if ! command -v codex >/dev/null 2>&1; then
    echo "Errore: il CLI Codex non è installato." >&2
    echo "        Installalo (https://github.com/openai/codex) oppure usa la modalità apikey (OPENAI_API_KEY)." >&2
    return 1
  fi
  echo "Avvio login ChatGPT (device flow: apri il link e inserisci il codice)..."
  codex login --device-auth
}

# --- 0) Comando `login` -------------------------------------------------------
if [[ "${1:-}" == "login" ]]; then
  require_base_tools
  codex_login || exit 1
  if has_codex_auth; then
    echo "Login completato: $CODEX_AUTH aggiornato."
    exit 0
  fi
  echo "Errore: login non riuscito ($CODEX_AUTH senza token)." >&2
  exit 1
fi

# --- 1) Migrazione dello stato dei vecchi script ------------------------------
mkdir -p "$STATE_ROOT/go" "$STATE_ROOT/openai"
# opencc <= 1 teneva lo stato OpenAI direttamente in $STATE_ROOT.
for f in last-model last-effort; do
  [[ -f "$STATE_ROOT/$f" && ! -f "$STATE_ROOT/openai/$f" ]] && mv -f "$STATE_ROOT/$f" "$STATE_ROOT/openai/$f"
done
# cc-go teneva il proprio stato in ~/.local/state/cc-go.
if [[ -d "$HOME/.local/state/cc-go" ]]; then
  for f in last-model last-effort models.tsv models.ids; do
    [[ -f "$HOME/.local/state/cc-go/$f" && ! -f "$STATE_ROOT/go/$f" ]] && \
      cp -f "$HOME/.local/state/cc-go/$f" "$STATE_ROOT/go/$f"
  done
fi

# --- 2) Scelta del backend ----------------------------------------------------
BACKEND="${OPENCC_BACKEND:-}"
if [[ -z "$BACKEND" ]]; then
  BACKEND_DEFAULT="openai"
  if [[ -f "$BACKEND_FILE" ]]; then
    STORED_BACKEND="$(<"$BACKEND_FILE")"
    [[ "$STORED_BACKEND" == "go" || "$STORED_BACKEND" == "openai" || "$STORED_BACKEND" == "anthropic" ]] && BACKEND_DEFAULT="$STORED_BACKEND"
  fi
  echo "Backend disponibili:"
  echo "   1) openai  — modelli OpenAI (abbonamento ChatGPT o API key, proxy locale)"
  echo "   2) go      — gateway OpenCode Go (x-api-key)"
  echo "   0) anthropic — Claude Code standard (pass-through, nessuna modifica)"
  while true; do
    printf "\nScegli il backend [0-2] (invio/d = %s): " "$BACKEND_DEFAULT"
    read -r CHOICE || CHOICE=""
    case "$CHOICE" in
      ""|d) BACKEND="$BACKEND_DEFAULT"; break ;;
      0|anthropic) BACKEND="anthropic"; break ;;
      1|openai) BACKEND="openai"; break ;;
      2|go) BACKEND="go"; break ;;
      *) echo "Scelta non valida, riprova." ;;
    esac
  done
fi
case "$BACKEND" in
  go|openai|anthropic) ;;
  *) echo "Errore: backend non valido ('$BACKEND'); usa go, openai o anthropic." >&2; exit 1 ;;
esac
printf '%s\n' "$BACKEND" > "$BACKEND_FILE"

if [[ "$BACKEND" == "anthropic" ]]; then
  echo "Avvio Claude Code standard (backend: anthropic)."
  exec claude "$@"
fi

require_base_tools
command -v node >/dev/null 2>&1 || { echo "Errore: 'node' non trovato nel PATH (richiesto dal proxy)." >&2; exit 1; }

STATE_DIR="$STATE_ROOT/$BACKEND"
STATE_FILE="$STATE_DIR/last-model"
STATE_EFFORT_FILE="$STATE_DIR/last-effort"
MODELS_CACHE="$STATE_DIR/models.tsv"

# --- 3) Credenziali e elenco modelli ------------------------------------------
# Formato TSV comune: slug<TAB>nome<TAB>contesto<TAB>livelli di ragionamento<TAB>default
MODELS=""
MODE=""
KEY=""

if [[ "$BACKEND" == "go" ]]; then
  # API key: env OPENCODE_API_KEY, fallback auth.json (parsing con python3, niente jq)
  if [[ -n "${OPENCODE_API_KEY:-}" ]]; then
    KEY="$OPENCODE_API_KEY"
  elif [[ -f "$GO_AUTH_JSON" ]]; then
    KEY="$(python3 - "$GO_AUTH_JSON" <<'PY' 2>/dev/null || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('opencode-go', {}).get('key', ''))
except Exception:
    pass
PY
)"
  fi
  if [[ -z "$KEY" ]]; then
    echo "Errore: nessuna API key trovata (setta OPENCODE_API_KEY o fai login con opencode)." >&2
    exit 1
  fi

  # Cache modelli: elenco da /v1/models, contesto ed effort dal catalogo upstream.
  # Costruita una tantum e rinfrescata in background quando scaduta.
  build_go_models_tsv() {
    local ids tmp
    ids="$(curl -fsS -m 15 -H "x-api-key: $KEY" "$GO_MODELS_URL" 2>/dev/null | python3 -c '
import sys, json
try:
    print("\n".join(m.get("id", "") for m in json.load(sys.stdin).get("data", [])))
except Exception:
    pass
' || true)"
    [[ -z "$ids" ]] && return 1
    tmp="$(mktemp "$MODELS_CACHE.XXXXXX")" || return 1
    if curl -fsS -m 25 "$GO_CATALOG_URL" 2>/dev/null | python3 -c '
import json, sys
# Claude Code accetta questi livelli in --effort: intersecali con quelli del modello.
CLAUDE_EFFORTS = {"low","medium","high","xhigh","max"}
try:
    cat = json.load(sys.stdin)
    go = cat.get("opencode-go", {}).get("models", {})
except Exception:
    go = {}
for mid in sys.argv[1].splitlines():
    m = go.get(mid, {}) or {}
    ctx = (m.get("limit") or {}).get("context") or ""
    efforts = ""
    for o in m.get("reasoning_options") or []:
        if o.get("type") == "effort":
            efforts = ",".join(v for v in o.get("values", []) if v in CLAUDE_EFFORTS)
            break
    print(f"{mid}\t{mid}\t{ctx}\t{efforts}\t")
' "$ids" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
      mv -f "$tmp" "$MODELS_CACHE"
      printf '%s\n' "$ids" > "$STATE_DIR/models.ids"
      return 0
    fi
    rm -f "$tmp"
    return 1
  }

  # La cache ereditata da cc-go ha 3 colonne: rigenerala nel formato a 5 colonne.
  if [[ -s "$MODELS_CACHE" ]] && [[ "$(head -n1 "$MODELS_CACHE" | awk -F'\t' '{print NF}')" != "5" ]]; then
    rm -f "$MODELS_CACHE"
  fi
  [[ -s "$MODELS_CACHE" ]] || build_go_models_tsv >/dev/null 2>&1 || true

  # NB: $(<file) non va combinato con redirect o `|| true` (produce output vuoto).
  if [[ -s "$MODELS_CACHE" ]]; then
    MODELS="$(<"$MODELS_CACHE")"
    # Cache scaduta: rinfresca senza bloccare l'avvio.
    cache_age=$(( $(date +%s) - $(stat -c %Y "$MODELS_CACHE" 2>/dev/null || echo 0) ))
    (( cache_age > GO_MODELS_MAX_AGE )) && { build_go_models_tsv >/dev/null 2>&1 & disown; }
  fi
  if [[ -z "$MODELS" ]]; then
    MODELS="$(printf '%s\t%s\t\t\t' "$GO_FALLBACK_MODEL" "$GO_FALLBACK_MODEL")"
  fi

else
  # Modalità di autenticazione: subscription (predefinita) o apikey.
  MODE="${OPENCC_MODE:-}"
  if [[ -z "$MODE" ]]; then
    if has_codex_auth; then
      MODE="subscription"
    elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
      MODE="apikey"
    else
      # Nessuna credenziale: proponi il login subscription (prompt qui sotto).
      MODE="subscription"
    fi
  fi
  case "$MODE" in
    subscription|apikey) ;;
    *) echo "Errore: OPENCC_MODE non valido ('$MODE'); usa subscription o apikey." >&2; exit 1 ;;
  esac
  if [[ "$MODE" == "apikey" && -z "${OPENAI_API_KEY:-}" ]]; then
    echo "Errore: modalità apikey richiede OPENAI_API_KEY." >&2
    exit 1
  fi

  # Autenticazione subscription mancante: proponi il login.
  if [[ "$MODE" == "subscription" ]] && ! has_codex_auth; then
    echo "Autenticazione ChatGPT non trovata ($CODEX_AUTH assente o senza token)." >&2
    printf "Vuoi fare login adesso (device flow via Codex)? [s/N] "
    read -r ANS || ANS=""
    if [[ "$ANS" =~ ^[sSyY]$ ]]; then
      codex_login || exit 1
    fi
    if ! has_codex_auth; then
      echo "Errore: nessun login completato. Riprova con \`opencc login\` oppure imposta OPENAI_API_KEY." >&2
      exit 1
    fi
  fi

  # Il contesto è max_context_window × effective_context_window_percent (95%),
  # cioè la finestra estesa che il backend supporta per il piano.
  if [[ "$MODE" == "subscription" ]] && [[ -f "$CODEX_MODELS_CACHE" ]]; then
    MODELS="$(python3 - "$CODEX_MODELS_CACHE" <<'PY' 2>/dev/null || true
import json, sys
d = json.load(open(sys.argv[1]))
for m in d.get("models", []):
    slug = m.get("slug", "")
    if not slug or slug == "codex-auto-review":
        continue
    disp = m.get("display_name") or slug
    ctx = ""
    mw = m.get("max_context_window") or m.get("context_window")
    eff = m.get("effective_context_window_percent")
    try:
        if mw and eff:
            ctx = int(int(mw) * int(eff) / 100)
    except Exception:
        ctx = ""
    efforts = ",".join(e.get("effort", "") for e in m.get("supported_reasoning_levels", []) if e.get("effort"))
    dflt = m.get("default_reasoning_level") or ""
    print(f"{slug}\t{disp}\t{ctx}\t{efforts}\t{dflt}")
PY
)"
  fi
  if [[ -z "$MODELS" ]] && [[ "$MODE" == "apikey" ]] && [[ -n "${OPENAI_API_KEY:-}" ]]; then
    MODELS="$(curl -fsS -m 20 -H "Authorization: Bearer $OPENAI_API_KEY" \
      "https://api.openai.com/v1/models" 2>/dev/null | python3 -c '
import json, sys, re
d = json.load(sys.stdin)
for m in d.get("data", []):
    mid = m.get("id", "")
    if re.search(r"^gpt-|^o[0-9]", mid) and not re.search(r"realtime|audio|image|whisper|tts|embed|dall|moderation|vision|codex", mid):
        print(f"{mid}\t{mid}\t\tlow,medium,high\tmedium")
' 2>/dev/null || true)"
  fi
  if [[ -z "$MODELS" ]]; then
    MODELS="$(while IFS= read -r slug; do
      case "$slug" in
        gpt-5.6-sol|gpt-5.6-terra|gpt-5.6-luna) e="low,medium,high,xhigh,max,ultra"; d="low" ;;
        gpt-5.5|gpt-5.4|gpt-5.4-mini) e="low,medium,high,xhigh"; d="medium" ;;
        *) e="low,medium,high"; d="medium" ;;
      esac
      printf '%s\t%s\t\t%s\t%s\n' "$slug" "$slug" "$e" "$d"
    done <<< "$OPENAI_FALLBACK_MODELS")"
  fi
fi

MODEL_ARR=()
DISPLAY_ARR=()
declare -A CTX=()
declare -A EFFORTS=()
declare -A DFLT_EFFORT=()
# NB: il tab è un separatore IFS "whitespace", quindi `read -r a b c` collasserebbe
# i tab consecutivi e sposterebbe i campi quando una colonna è vuota (contesto
# ignoto): le righe vanno divise a mano.
while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  slug="${line%%$'\t'*}";    line="${line#*$'\t'}"
  disp="${line%%$'\t'*}";    line="${line#*$'\t'}"
  ctx="${line%%$'\t'*}";     line="${line#*$'\t'}"
  efforts="${line%%$'\t'*}"; dflt="${line#*$'\t'}"
  [[ -z "$slug" ]] && continue
  MODEL_ARR+=("$slug")
  DISPLAY_ARR+=("${disp:-$slug}")
  [[ -n "$ctx" ]] && CTX["$slug"]="$ctx"
  [[ -n "$efforts" ]] && EFFORTS["$slug"]="$efforts"
  [[ -n "$dflt" ]] && DFLT_EFFORT["$slug"]="$dflt"
done <<< "$MODELS"

if [[ ${#MODEL_ARR[@]} -eq 0 ]]; then
  echo "Errore: nessun modello disponibile." >&2
  exit 1
fi

# Claude Code filtra dalla discovery automatica tutti gli ID che non contengono
# `claude` o `anthropic`; i nostri ID reali (`gpt-*`, `minimax-*`, ecc.) non
# comparirebbero quindi in /model anche con un endpoint /v1/models valido.
# modelPicker è il meccanismo nativo che accetta ID arbitrari: generiamo opzioni
# specifiche per il backend corrente e nascondiamo gli alias Anthropic, che con
# questi gateway sarebbero fuorvianti.
PICKER_SETTINGS_FILE="$STATE_DIR/model-picker.json"
EFFORT_POLICY_FILE="$STATE_DIR/model-efforts.json"
if [[ "$BACKEND" == "go" ]]; then
  PICKER_DESCRIPTION="OpenCode Go via opencc"
else
  PICKER_DESCRIPTION="OpenAI via opencc ($MODE)"
fi
printf '%s\n' "$MODELS" | python3 -c '
import json, os, sys, tempfile
picker_output, policy_output, base_description = sys.argv[1:4]
options = []
policies = {}
for line in sys.stdin:
    fields = (line.rstrip("\n").split("\t") + [""] * 5)[:5]
    model, label, _context, effort_csv, default = fields
    if not model:
        continue
    label = label or model
    supported = [v for v in effort_csv.split(",") if v]
    if default not in supported:
        default = ""
    if supported:
        effort_description = "effort: " + ", ".join(supported)
        if default:
            effort_description += f" (default: {default})"
    else:
        effort_description = "effort: non configurabile"
    options.append({
        "model": model,
        "label": label,
        "description": f"{base_description} · {effort_description}",
    })
    policies[model] = {"supported": supported, "default": default or None}

def atomic_json(path, data, prefix):
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=prefix, dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass

atomic_json(picker_output, {
    "modelPicker": {"replaceBuiltInOptions": True, "options": options}
}, ".model-picker.")
atomic_json(policy_output, {"models": policies}, ".model-efforts.")
' "$PICKER_SETTINGS_FILE" "$EFFORT_POLICY_FILE" "$PICKER_DESCRIPTION"

# --- 4) Default = ultimo usato (se ancora disponibile) ------------------------
if [[ "$BACKEND" == "go" ]]; then
  DEFAULT="$GO_FALLBACK_MODEL"
  [[ " ${MODEL_ARR[*]} " == *" $DEFAULT "* ]] || DEFAULT="${MODEL_ARR[0]}"
else
  DEFAULT="${MODEL_ARR[0]}"
fi
LAST_USED=""
if [[ -f "$STATE_FILE" ]]; then
  STORED="$(<"$STATE_FILE")"
  for m in "${MODEL_ARR[@]}"; do
    [[ "$m" == "$STORED" ]] && { DEFAULT="$STORED"; LAST_USED="$STORED"; break; }
  done
fi

# --- 5) Menu numerato ---------------------------------------------------------
if [[ "$BACKEND" == "go" ]]; then
  echo "Modelli OpenCode Go:"
else
  echo "Modelli OpenAI (auth: $MODE):"
fi
for i in "${!MODEL_ARR[@]}"; do
  tag=""
  ctxstr=""
  [[ -n "${CTX[${MODEL_ARR[$i]}]:-}" ]] && ctxstr="  [$(fmt_ctx "${CTX[${MODEL_ARR[$i]}]}")]"
  [[ "${MODEL_ARR[$i]}" == "$LAST_USED" ]] && tag="  (ultimo usato)"
  printf "  %2d) %s%s%s\n" "$((i+1))" "${DISPLAY_ARR[$i]}" "$ctxstr" "$tag"
done

while true; do
  printf "\nScegli un modello [1-%d] (invio/%s = %s): " "${#MODEL_ARR[@]}" "d" "$DEFAULT"
  read -r CHOICE || CHOICE=""
  [[ -z "$CHOICE" || "$CHOICE" == "d" ]] && { MODEL="$DEFAULT"; break; }
  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && (( CHOICE >= 1 && CHOICE <= ${#MODEL_ARR[@]} )); then
    MODEL="${MODEL_ARR[$((CHOICE-1))]}"
    break
  fi
  echo "Scelta non valida, riprova."
done

# --- 6) Livello di ragionamento (effort) --------------------------------------
# Sul backend go i modelli `toggle` (ragionamento sempre attivo) non espongono
# livelli: in quel caso il prompt viene saltato.
if [[ "$BACKEND" == "go" ]]; then
  VALID_EFFORTS="${EFFORTS[$MODEL]:-}"
else
  VALID_EFFORTS="${EFFORTS[$MODEL]:-low,medium,high}"
fi
EFFORT=""
if [[ -n "$VALID_EFFORTS" ]]; then
  EFFORT_DEFAULT=""
  if [[ -f "$STATE_EFFORT_FILE" ]]; then
    EFFORT_DEFAULT="$(<"$STATE_EFFORT_FILE")"
    # Se il default salvato non è valido per questo modello, riparti da vuoto.
    [[ ",$VALID_EFFORTS," == *",$EFFORT_DEFAULT,"* ]] || EFFORT_DEFAULT=""
  fi
  DFLT_SHOW="${DFLT_EFFORT[$MODEL]:-}"
  DEFPROMPT="${EFFORT_DEFAULT:-default del modello${DFLT_SHOW:+ ($DFLT_SHOW)}}"
  printf "Livello di ragionamento [%s] (invio = %s): " "$VALID_EFFORTS" "$DEFPROMPT"
  read -r EFFORT || EFFORT=""
  [[ -z "$EFFORT" ]] && EFFORT="$EFFORT_DEFAULT"
  if [[ -n "$EFFORT" ]] && ! [[ ",$VALID_EFFORTS," == *",$EFFORT,"* ]]; then
    echo "Livello non valido ('$EFFORT'); uso il default." >&2
    EFFORT="$EFFORT_DEFAULT"
  fi
fi

# Claude Code invia gli effort low..max in output_config.effort. `ultra` non è
# disponibile in /effort, quindi resta codificato nel modello come @ultra.
if [[ "$EFFORT" == "ultra" ]]; then
  MODEL_EFFORT="${MODEL}@ultra"
else
  MODEL_EFFORT="$MODEL"
fi

# --- 7) Salva l'ultimo modello + effort ---------------------------------------
printf '%s\n' "$MODEL" > "$STATE_FILE"
printf '%s\n' "$EFFORT" > "$STATE_EFFORT_FILE"

# --- 8) Proxy locale: avvio o riuso se già coerente ----------------------------
if [[ "$BACKEND" == "go" ]]; then
  PROXY_MODE="go"
else
  PROXY_MODE="$MODE"
fi

ensure_proxy() {
  local health ver mode
  health="$(curl -fsS -m 2 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
  if [[ -n "$health" ]]; then
    ver="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)"
    mode="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("mode", ""))' 2>/dev/null || true)"
    if [[ "$ver" == "$EXPECTED_PROXY_VERSION" && "$mode" == "$PROXY_MODE" ]]; then
      return 0
    fi
    echo "Errore: sulla porta $PORT è già attivo un proxy opencc incompatibile" >&2
    echo "        (versione o modalità differente)." >&2
    echo "        Chiudilo manualmente oppure usa una porta diversa con OPENCC_PROXY_PORT." >&2
    exit 1
  else
    # Porta occupata da un processo estraneo?
    if (command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]${PORT} ") || \
       (command -v lsof >/dev/null 2>&1 && lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1); then
      echo "Errore: la porta $PORT è occupata da un altro processo." >&2
      echo "        Imposta OPENCC_PROXY_PORT su una porta libera." >&2
      exit 1
    fi
  fi

  [[ -f "$PROXY_SCRIPT" ]] || { echo "Errore: $PROXY_SCRIPT non trovato (manca accanto a opencc)." >&2; exit 1; }

  local models_csv
  models_csv="$(IFS=,; printf '%s' "${MODEL_ARR[*]}")"
  OPENCC_MODE="$PROXY_MODE" \
  OPENAI_API_KEY="${OPENAI_API_KEY:-}" \
  OPENCODE_API_KEY="$KEY" \
  OPENCC_GO_BASE_URL="$GO_BASE_URL" \
  OPENCC_PROXY_PORT="$PORT" \
  OPENCC_FALLBACK_MODEL="$MODEL_EFFORT" \
  OPENCC_MODELS="$models_csv" \
  OPENCC_EFFORT_POLICY_FILE="$EFFORT_POLICY_FILE" \
  nohup node "$PROXY_SCRIPT" >>"$STATE_DIR/proxy.log" 2>&1 &
  local proxy_pid=$!
  printf '%s\n' "$proxy_pid" > "$STATE_DIR/proxy.pid"
  disown "$proxy_pid"

  for _ in $(seq 1 25); do
    health="$(curl -fsS -m 1 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
    [[ -n "$health" ]] && return 0
    sleep 0.1
  done
  echo "Errore: il proxy non si è avviato (log: $STATE_DIR/proxy.log)." >&2
  exit 1
}

# --- 8b) Registro sessioni: il proxy si chiude con l'ultima sessione -----------
# Ogni invocazione registra un file in $STATE_DIR/sessions/<pid>.sess con la
# coppia porta|modalità del proxy che usa. All'uscita da claude il file viene
# rimosso; se non resta nessuna sessione sullo stesso proxy, il proxy viene
# fermato. I file di sessioni terminate in modo anomalo (PID non più vivo)
# vengono spazzati all'avvio successivo.
SESSION_DIR="$STATE_DIR/sessions"
mkdir -p "$SESSION_DIR"

sweep_stale_sessions() {
  local f pid
  for f in "$SESSION_DIR"/*.sess; do
    [[ -e "$f" ]] || continue
    pid="${f##*/}"; pid="${pid%.sess}"
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
}

sessions_on_proxy() {
  local f
  local n=0
  for f in "$SESSION_DIR"/*.sess; do
    [[ -e "$f" ]] || continue
    [[ "$(<"$f")" == "$PORT|$PROXY_MODE" ]] && (( n++ ))
  done
  printf '%d' "$n"
}

stop_proxy_if_last() {
  rm -f "$SESSION_DIR/$$.sess"
  sweep_stale_sessions
  if [[ "$(sessions_on_proxy)" == "0" ]]; then
    local health ver mode
    health="$(curl -fsS -m 2 "$PROXY_BASE_URL/health" 2>/dev/null || true)"
    if [[ -n "$health" ]]; then
      ver="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)"
      mode="$(printf '%s' "$health" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("mode", ""))' 2>/dev/null || true)"
      if [[ "$ver" == "$EXPECTED_PROXY_VERSION" && "$mode" == "$PROXY_MODE" ]]; then
        kill "$(<"$STATE_DIR/proxy.pid")" 2>/dev/null || true
        rm -f "$STATE_DIR/proxy.pid"
        echo "Proxy opencc fermato (ultima sessione chiusa)." >&2
      fi
    fi
  fi
}

# Registrazione anticipata (prima di ensure_proxy): se un'altra sessione termina
# mentre questa sta ancora avviandosi, il proxy non viene chiuso sotto i piedi.
sweep_stale_sessions
printf '%s\n' "$PORT|$PROXY_MODE" > "$SESSION_DIR/$$.sess"
trap stop_proxy_if_last EXIT

# --- 9) Export e avvio --------------------------------------------------------
unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_IDENTITY_TOKEN
EXTRA=()

ensure_proxy
export ANTHROPIC_BASE_URL="$PROXY_BASE_URL"
if [[ "$BACKEND" == "openai" && "$MODE" == "apikey" ]]; then
  export ANTHROPIC_API_KEY="$OPENAI_API_KEY"
else
  # Il proxy gestisce l'autenticazione upstream; un valore locale non vuoto
  # basta a disattivare il login OAuth di Claude Code.
  export ANTHROPIC_API_KEY="opencc-$PROXY_MODE"
fi
unset ANTHROPIC_CUSTOM_HEADERS
export ANTHROPIC_DEFAULT_MODEL="$MODEL_EFFORT"
export ANTHROPIC_MODEL="$MODEL_EFFORT"

# Il modello viene proposto come default della sessione; le opzioni generate in
# model-picker.json permettono poi a `/model` di cambiarlo a runtime.
unset CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY

# L'effort va passato con --effort, che imposta il livello *della sessione*: resta
# modificabile con /effort. La variabile CLAUDE_CODE_EFFORT_LEVEL lo inchioderebbe
# invece per tutto il processo, rendendo /effort inefficace: va anzi disattivata se
# ereditata dall'ambiente. `ultra` non e' accettato da --effort (viene ignorato in
# silenzio): resta codificato nel modello come @ultra.
unset CLAUDE_CODE_EFFORT_LEVEL
if [[ -n "$EFFORT" && "$EFFORT" != "ultra" ]] && [[ "$*" != *"--effort"* ]]; then
  EXTRA=(--effort "$EFFORT")
fi

export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL_EFFORT"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL_EFFORT"
# L'alias haiku alimenta il classificatore dell'auto-mode e le attività di
# background. Il classificatore usa max_tokens=1: i modelli con ragionamento
# consumano quel token nel thinking e non producono testo, quindi l'auto mode
# fallisce. Pinniamo l'alias su un modello piccolo SENZA ragionamento.
if [[ "$BACKEND" == "go" ]]; then
  CLASSIFIER_MODEL="minimax-m3"
  for m in "${MODEL_ARR[@]}"; do
    [[ -z "${EFFORTS[$m]:-}" ]] && { CLASSIFIER_MODEL="$m"; break; }
  done
else
  CLASSIFIER_MODEL="gpt-5.4-mini"
  for m in "${MODEL_ARR[@]}"; do
    [[ "$m" == *mini* ]] && { CLASSIFIER_MODEL="$m"; break; }
  done
  [[ " ${MODEL_ARR[*]} " == *" $CLASSIFIER_MODEL "* ]] || CLASSIFIER_MODEL="${MODEL_ARR[0]}"
fi
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$CLASSIFIER_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$MODEL_EFFORT"
if [[ -n "${CTX[$MODEL]:-}" ]]; then
  export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CTX[$MODEL]}"
fi

CTXSTR=""
[[ -n "${CTX[$MODEL]:-}" ]] && CTXSTR=", contesto: $(fmt_ctx "${CTX[$MODEL]}")"
EFFSTR=""
[[ -n "$EFFORT" ]] && EFFSTR=", ragionamento: $EFFORT"
if [[ "$BACKEND" == "go" ]]; then
  echo "Avvio Claude Code con modello: $MODEL (backend: go$CTXSTR$EFFSTR)"
else
  echo "Avvio Claude Code con modello: $MODEL (backend: openai/$MODE$CTXSTR$EFFSTR)"
fi
echo "Durante la sessione: /model cambia il modello, /effort cambia il ragionamento."

# La registrazione è avvenuta nella sezione 8 (prima di ensure_proxy), così una
# sessione che termina mentre un'altra si sta avviando non chiude il proxy.
# set +e: claude può uscire con un codice non zero; lo propaghiamo noi.
set +e
claude --settings "$PICKER_SETTINGS_FILE" "${EXTRA[@]}" "$@"
status=$?
set -e
exit $status
